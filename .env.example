# Copy to .env and fill in real values. Never commit .env.
# Generate a secret with: openssl rand -base64 48

# REQUIRED. Signs session tokens. Must be at least 32 characters.
# The server refuses to start if this is missing, short, or a known placeholder.
JWT_SECRET=

# Port the server listens on inside the container.
PORT=4020

# Set to true when running behind a reverse proxy or Cloudflare tunnel so that
# login rate limiting sees the real client IP instead of the proxy.
TRUST_PROXY=true

# Set to true only when the app is served over HTTPS end to end.
# Leave false behind a Cloudflare tunnel, where the hop to the origin is plain HTTP.
COOKIE_SECURE=false

# Maximum icon upload size in megabytes.
MAX_UPLOAD_MB=2

# Login throttling.
LOGIN_WINDOW_MINUTES=15
LOGIN_MAX_ATTEMPTS=5

# Session token lifetime in days.
SESSION_DAYS=7
